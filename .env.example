# Storage destination (local path now; switch to fsspec cloud URI such as az:// or s3:// later)
STORAGE_URI=./data/bronze

# Persistent rotating log file (leave empty to log to stderr only)
LOG_FILE=./data/logs/ingestion.log

# Binance market data settings
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,TRUMPUSDT
BINANCE_INTERVAL=1m
BINANCE_INITIAL_LOOKBACK_HOURS=24

# Truth Social archive settings
TRUTH_SOCIAL_URL=https://ix.cnn.io/data/truth-social/truth_archive.json

# Continuous loop polling interval (seconds)
POLL_INTERVAL_SECONDS=300
